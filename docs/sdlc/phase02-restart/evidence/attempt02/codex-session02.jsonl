{"index":8,"server":"elixir_mixir","tool":"runtime_define","arguments":{"logical_name":"counter","source":"defmodule Generated do\n  @behaviour ElixirMixir.Behavior\n\n  @impl true\n  def init(%{\"schema\" => 2, \"counter\" => %{\"count\" => count, \"target\" => target}} = config)\n      when is_number(count) and is_binary(target), do: {:ok, config}\n  def init(_config), do: {:error, \"invalid nested state\"}\n\n  @impl true\n  def handle_event(%{\"amount\" => amount}, %{\"counter\" => %{\"count\" => count, \"target\" => target} = counter} = state)\n      when is_number(amount) and amount > 0 do\n    new_count = count + 3 * amount\n    new_state = Map.put(state, \"counter\", Map.put(counter, \"count\", new_count))\n    effects = [%{\"type\" => \"emit\", \"to\" => target, \"event\" => %{\"value\" => new_count}}]\n    {:ok, new_count, new_state, effects}\n  end\n  def handle_event(_event, _state), do: {:error, \"amount must be positive\"}\n\n  @impl true\n  def state_schema(), do: 2\n\n  @impl true\n  def migrate(_old_state, _metadata), do: {:error, \"same-schema migration must not run\"}\nend","expected_behavior":"elixir_mixir.behavior.v1","request_id":"p2s2_define_v3_1"},"status":"completed","result":{"api_version":"1","artifact_id":"artifact_b2585b5587f82948688bb494e25126d5","callbacks_valid":true,"compilation_status":"compiled","diagnostics":[],"generation":19,"module":"Elixir.ElixirMixir.Generated.Slot004","request_id":"p2s2_define_v3_1","revision":3,"source_hash":"b90f082c46f17926501b6dd7962d1f01518cf5563e33c48fb2819b7b7d3d75da","state_schema":2}}

#!/bin/sh

# The release runs without distribution or writes to its immutable application tree.
export RELEASE_DISTRIBUTION=none
export RELEASE_TMP=/tmp/elixir_mixir
export ERL_CRASH_DUMP=/tmp/elixir_mixir.dump

# Bound VM threads and the port table. Docker may otherwise supply a billion-FD
# limit, causing OTP 27 to allocate a multi-gigabyte port table before boot.
export ERL_FLAGS="+S 2:2 +SDcpu 1 +SDio 1 +A 2 +Q 65536"
